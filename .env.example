SECRET_KEY=your-secret-key-here
DEBUG=True
# 로컬: docker-compose.yml 사용 시 → DATABASE_URL은 docker-compose.yml의 environment에서 주입되므로 생략 가능
# Dev EC2: docker-compose.dev.yml 사용 시 → EC2에 설치된 PostgreSQL에 연결 (host networking)
DATABASE_URL=postgres://homen:homen@localhost:5432/homen
ALLOWED_HOSTS=*
CLAUDE_API_KEY=your-claude-api-key-here

# Kakao OAuth2
# KAKAO_REDIRECT_URI는 FE가 인가 코드(code)를 받을 때 사용한 redirect_uri와
# 글자 단위로 동일해야 하며, 카카오 콘솔에도 같은 값이 등록돼 있어야 합니다.
# 불일치 시 토큰 교환이 KOE320(authorization code not found)으로 실패합니다.
#   - 웹 FE  : 웹 URI            예) http://localhost:8080/auth/kakao/callback
#   - 모바일 앱: native 스킴      예) kakao{NATIVE_APP_KEY}://oauth
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_REDIRECT_URI=http://localhost:8000/api/v1/auth/kakao/
# 모바일 앱이 Kakao SDK로 받은 인가 코드는 "네이티브 앱 키"로 발급되므로,
# 발급 키와 동일한 키로 교환하지 않으면 KOE320(authorization code not found)이 발생합니다.
# redirect_uri가 kakao{NATIVE_APP_KEY}://oauth 스킴이면 서버가 이 키로 교환합니다.
KAKAO_NATIVE_APP_KEY=your-kakao-native-app-key

# Apple Sign In
APPLE_TEAM_ID=your-apple-team-id
APPLE_CLIENT_ID=com.your.app.bundle-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\nyour-private-key-here\n-----END EC PRIVATE KEY-----"
